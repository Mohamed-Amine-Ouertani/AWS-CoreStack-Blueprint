# Terraform state and lock files — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.lock.hcl

# Terraform working directories — generated by terraform init
**/.terraform/

# Plan files — contain sensitive data (secrets in variables)
tfplan
*.tfplan

# Variable files with real values — .example versions are committed
terraform.tfvars
!terraform.tfvars.example

# Override files — local developer overrides, not for version control
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash log from Terraform
crash.log
crash.*.log

# CLI config file
.terraformrc
terraform.rc

# Infracost breakdown output
.infracost/

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.idea/
.vscode/
*.swp
*.swo
*~

# Environment files — contain secrets
.env
.env.*
!.env.example
